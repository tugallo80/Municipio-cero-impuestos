# ══════════════════════════════════════════════════
#  ÑANDÉ Educación — variables (referencia)
#  NO SECRETAS → services/ai-gateway/.env (se publican con las Functions)
#  SECRETAS    → Secret Manager del proyecto municipio-ia (nunca en el repo)
# ══════════════════════════════════════════════════

# ── Secret Manager ─────────────────────────────────
# GEMINI_API_KEY        (= AI_PROVIDER_API_KEY de la visión). Ya existe.
# TWILIO_AUTH_TOKEN     solo cuando se publique el webhook de WhatsApp (fuera de EDU.02).

# ── services/ai-gateway/.env ───────────────────────
EDU_DATABASE_URL=https://municipio-ia-educacion.firebaseio.com
# EDU_MODELO_KAY=gemini-3.1-flash-live-preview      # = AI_MODEL_TIER
# MAX_TOKENS_PER_STUDENT_DAY=600000
# EDU_MAX_SESIONES_ALUMNO_DIA=8
# EDU_MAX_MINUTOS_SESION=10
# EDU_TOPE_COSTO_GLOBAL_DIA_USD=5
# Precios USD por millón de tokens (confirmar en ai.google.dev/pricing):
# EDU_PRECIO_ENTRADA_TEXTO=0.75
# EDU_PRECIO_ENTRADA_AUDIO=3
# EDU_PRECIO_SALIDA_TEXTO=4.5
# EDU_PRECIO_SALIDA_AUDIO=12

# ── Para más adelante (EDU.11, sin internet) ───────
# LOCAL_ENCRYPTION_KEY_SALT=
# ENABLE_OFFLINE_CACHE=false
